# Source and metadata: plain text
*.cs text eol=lf
*.meta text eol=lf

# Unity serialized assets: YAML merge driver, no line-ending conversion
# (some .asset files, such as LightingData, are always binary)
*.unity merge=unityyamlmerge -text
*.prefab merge=unityyamlmerge -text
*.asset merge=unityyamlmerge -text
*.mat merge=unityyamlmerge -text
*.controller merge=unityyamlmerge -text
*.anim merge=unityyamlmerge -text

# Binary media in Git LFS
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
